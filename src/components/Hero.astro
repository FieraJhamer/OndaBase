---
interface Props {
  imagen?: string;
}

const { imagen } = Astro.props;
---

<section class="hero" id="inicio">
  <div
    class:list={['hero__bg', { 'hero__bg--imagen': imagen }]}
    style={imagen ? `background-image: url('${imagen}')` : undefined}
  ></div>
  {imagen && <div class="hero__scrim"></div>}
  <div class="hero__content container">
    <p class="hero__tag">Nueva Colección 2026</p>
    <h1 class="hero__title">ONDA BASE</h1>
    <a href="#coleccion" class="hero__cta">Ver Colección</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height-lg));
    overflow: hidden;
    text-align: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--color-secondary) 0%, var(--color-bg) 70%);
    opacity: 0.4;
  }

  .hero__bg--imagen {
    background-size: cover;
    background-position: center;
    opacity: 1;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(10, 13, 13, 0.6);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__tag {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: var(--space-xs) var(--space-md);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text);
    line-height: 1;
  }

  .hero__cta {
    display: inline-block;
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-2xl);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    background-color: var(--color-primary);
    transition: background-color var(--transition-fast);
  }

  .hero__cta:hover {
    background-color: #b08228;
  }
</style>
