---
interface Props {
  id: string;
  nombre: string;
  precio: number;
  imagen: string;
  categoria: string;
}

const { id, nombre, precio, imagen, categoria } = Astro.props;
---

<article class="product-card" data-product-id={id} data-categoria={categoria}>
<div class="product-card__img-wrap">
      <img src={imagen} alt={nombre} class="product-card__img" loading="lazy" />
      <button class="product-card__view" type="button">Ver detalles</button>
    </div>
  <div class="product-card__info">
    <h3 class="product-card__name">{nombre}</h3>
    <p class="product-card__price">${precio.toLocaleString('es-AR')}</p>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .product-card:hover {
    border-color: var(--color-primary);
  }

  .product-card__img-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-border);
    cursor: pointer;
  }

  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .product-card:hover .product-card__img {
    transform: scale(1.05);
  }

  .product-card__view {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bg);
    background-color: var(--color-primary);
    opacity: 0;
    transform: translateY(100%);
    transition: all var(--transition-base);
  }

  .product-card:hover .product-card__view,
  .product-card__view:focus {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__name {
    cursor: pointer;
  }

  .product-card__info {
    flex: 1;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .product-card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-card__price {
    margin-top: auto;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  @media (max-width: 640px) {
    .product-card__info {
      padding: var(--space-sm);
      gap: var(--space-xs);
    }

    .product-card__name {
      font-size: 0.9375rem;
    }

    .product-card__price {
      font-size: 1rem;
    }
  }
</style>
