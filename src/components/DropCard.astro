---
interface Props {
  id: string;
  nombre: string;
  tagline: string;
  fecha: string;
  imagenes: string[];
  cantidad: number;
}

const { id, nombre, tagline, fecha, imagenes, cantidad } = Astro.props;

const fechaFormateada = new Date(fecha + 'T00:00:00').toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="drop-card">
  <div class="drop-card__img-wrap">
    {imagenes.length === 1 ? (
      <img src={imagenes[0]} alt={nombre} class="drop-card__img" loading="lazy" />
    ) : (
      <div
        class:list={[
          'drop-card__collage',
          {
            'drop-card__collage--dos': imagenes.length === 2,
            'drop-card__collage--mos': imagenes.length >= 3,
          },
        ]}
      >
        {imagenes.slice(0, 4).map((src, i) => (
          <div
            class:list={[
              'drop-card__cell',
              { 'drop-card__cell--hero': imagenes.length === 3 && i === 0 },
            ]}
          >
            <img src={src} alt={`${nombre} — pieza ${i + 1}`} class="drop-card__img" loading="lazy" />
          </div>
        ))}
        {imagenes.length > 4 && <span class="drop-card__more">+{imagenes.length - 4}</span>}
      </div>
    )}
    <span class="drop-card__badge">{cantidad} {cantidad === 1 ? 'pieza' : 'piezas'}</span>
  </div>
  <div class="drop-card__body">
    <span class="drop-card__fecha">{fechaFormateada}</span>
    <h3 class="drop-card__nombre">{nombre}</h3>
    <button
      class="drop-card__view"
      data-drop-id={id}
      data-drop-nombre={nombre}
      data-drop-tagline={tagline}
      data-drop-fecha={fecha}
    >
      Ver productos
    </button>
  </div>
</article>

<style>
  .drop-card {
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .drop-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .drop-card__img-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .drop-card__collage {
    position: relative;
    display: grid;
    gap: 2px;
    height: 100%;
    background-color: var(--color-border);
  }

  .drop-card__collage--dos {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
  }

  .drop-card__collage--mos {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .drop-card__collage--mos .drop-card__cell--hero {
    grid-row: 1 / 3;
  }

  .drop-card__cell {
    position: relative;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .drop-card__cell .drop-card__img {
    transition: transform var(--transition-base);
  }

  .drop-card__more {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-primary);
  }

  .drop-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .drop-card:hover .drop-card__img {
    transform: scale(1.05);
  }

  .drop-card__badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bg);
    background-color: var(--color-primary);
  }

  .drop-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    flex: 1;
  }

  .drop-card__fecha {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }

  .drop-card__nombre {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .drop-card__view {
    margin-top: auto;
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    border: 1px solid var(--color-primary);
    transition: all var(--transition-fast);
  }

  .drop-card__view:hover {
    background-color: var(--color-primary);
    color: var(--color-bg);
  }

  @media (max-width: 640px) {
    .drop-card__body {
      padding: var(--space-md);
      gap: var(--space-xs);
    }

    .drop-card__nombre {
      font-size: 1.0625rem;
    }

    .drop-card__view {
      padding: var(--space-sm);
      font-size: 0.6875rem;
    }
  }
</style>